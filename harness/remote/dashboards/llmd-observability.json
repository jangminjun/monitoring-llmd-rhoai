{
  "title": "llm-d Observability (TTFT / Throughput / Error Rate)",
  "uid": "llmd-observability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "TTFT (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_THANOS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 2 }
        ] } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kserve_vllm:time_to_first_token_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))",
          "legendFormat": "TTFT p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Throughput (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_THANOS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(kserve_http_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "Total requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_THANOS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 0.05 }
        ] } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(kserve_http_requests_total{namespace=\"$namespace\",status=~\"4xx|5xx\"}[5m])) / sum(rate(kserve_http_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "Error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "KV Cache Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_THANOS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kserve_vllm:kv_cache_usage_perc{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": "${DS_THANOS}",
        "query": "label_values(kserve_vllm:request_success_total, namespace)",
        "refresh": 2,
        "includeAll": false
      }
    ]
  }
}
