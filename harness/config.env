# Non-secret defaults for the llm-d/MaaS harness. This harness assumes the
# base cluster (bastion, OpenShift, GPU nodes, RHOAI, monitoring/logging)
# already exists -- built via openshift-aws-harness
# (https://github.com/jangminjun/openshift-aws-harness). This harness only
# adds llm-d-specific pieces on top: MaaS/RHCL, tracing, model deployment,
# and the scenario 11-14 demos. See ../AGENT.md for full cluster details.
#
# Override any of these by exporting the same name before invoking
# harness.sh, e.g.: BASTION_IP=1.2.3.4 ./harness.sh maas

CLUSTER_NAME="${CLUSTER_NAME:-myocp}"
BASTION_IP="${BASTION_IP:-3.94.158.230}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/${CLUSTER_NAME}-bastion}"

# GPU worker instance types available on this cluster (see AGENT.md) --
# used as defaults when a scenario doesn't specify its own.
GPU_INSTANCE_TYPE="${GPU_INSTANCE_TYPE:-g5.2xlarge}"
